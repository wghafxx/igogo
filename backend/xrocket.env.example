# Add these to the backend service variables in Railway. No REACT_APP_ prefix.
XROCKET_API_TOKEN=
XROCKET_WEBHOOK_SECRET=
# Optional: production is the default. For testnet use the official testnet URL.
XROCKET_API_BASE_URL=https://pay.api.xrocket.exchange
# CryptoBot (Crypto Pay API). Webhook URL in @CryptoBot -> Crypto Pay -> My Apps -> Webhooks: <PUBLIC_APP_URL>/api/payments/cryptobot/webhook
CRYPTOBOT_API_TOKEN=
CRYPTOBOT_TESTNET=false
